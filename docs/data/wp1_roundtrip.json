   {
    "file": "bowtie_polygon.yaml",
    "defect": "a self-intersecting (bow-tie) fence: vertex order crosses itself",
    "finding": "the grant's ingest pipeline names self-intersection as a geometry check; a bow-tie's 'inside' depends on the fill rule, so the zone enforced is not the zone drawn"
   },
   {
    "file": "collinear_polygon.yaml",
    "defect": "a zero-area fence: all vertices on one line",
    "finding": "a fence with no interior protects nothing while looking like a rule"
   },
   {
    "file": "duplicate_rule_id.yaml",
    "defect": "two rules share the id `nfz`",
    "finding": "audit records, KPI priorities (kpi.rule_priorities is a dict keyed by id) and hot-apply all address rules by id; a duplicate makes one of them unaddressable and can give a P0 rule the other's priority"
   },
   {
    "file": "duplicate_yaml_key.yaml",
    "defect": "the same key twice in one rule (alt_max_m: 30, then alt_max_m: 300)",
    "finding": "PyYAML keeps the LAST value without a word, so a reviewer reading the first sees 30 m while 300 m is enforced"
   },
   {
    "file": "empty_constraints.yaml",
    "defect": "constraints: [] - a policy with no rules",
    "finding": "the reference requires at least one rule (PolicyDoc min_length=1); an empty policy loads, hashes and 'passes' every flight"
   },
   {
    "file": "empty_policy_id.yaml",
    "defect": "policy_id is an empty string",
    "finding": "every artefact records policy_id; an empty one identifies nothing"
   },
   {
    "file": "infinite_speed_cap.yaml",
    "defect": "speed_max_mps is .inf",
    "finding": "an infinite cap passes `gt=0` and is no cap at all, while the policy still lists a kinematic envelope"
   },
   {
    "file": "misspelled_rule_key.yaml",
    "defect": "a fence field is misspelled (altitude_cieling_m), so the intended 40 m ceiling is dropped and the default 1000 m applies",
    "finding": "an extra key is ignored, so the zone silently covers 0-1000 m instead of 0-40 m and nothing reports the typo"
   },
   {
    "file": "nan_altitude.yaml",
    "defect": "alt_max_m is .nan",
    "finding": "NaN fails every comparison, including the alt_max > alt_min validator's negation, so the band loads; at run time every in-band test is False"
   },
   {
    "file": "negative_margin.yaml",
    "defect": "margin_m is -20 on a 10 m fence",
    "finding": "a negative safety ring shrinks the zone inward past nothing - here it erases the zone entirely"
   },
   {
    "file": "non_semver_version.yaml",
    "defect": "version: banana",
    "finding": "the grant requires a semver version; the version lock compares strings, so nothing orders 'banana' against 0.1.0"
   }
  ],
