// Camera loadout for the follow missions.
//
// FrontCamera is pitched -20 deg DOWN, not horizontal. Horizontal, its
// 29.4 deg vertical half-FOV meant a ground object only entered frame beyond
// 1.79 x altitude — so the car left the picture exactly when the drone got close
// enough to matter, and tracking broke at the moment it should have been easiest.
// Pitched down, ground is visible from 0.86 x altitude out to 573.0 x altitude:
// at a 9 m cruise that is 8 m to 5157 m instead of 16 m to the horizon.
//
// Chase is restored for the third-person view, at 640x360 so it costs little on
// the GPU the detector shares. Only Scene streams are kept anywhere; depth is
// not used by these missions and was being rendered for nothing.
// Chase is framed for demo recording: 16 m behind and 7 m above, pitched
// 22 deg down, so the aircraft and the road ahead of it are both in shot.
{
  "physics-type": "fast-physics",
  "links": [
    {
      "name": "Frame",
      "inertial": {
        "mass": 1.0,
        "inertia": {
          "type": "geometry",
          "geometry": {
            "box": {
              "size": "0.180 0.110 0.040"
            }
          }
        },
        "aerodynamics": {
          "drag-coefficient": 0.325,
          "type": "geometry",
          "geometry": {
            "box": {
              "size": "0.180 0.110 0.040"
            }
          }
        }
      },
