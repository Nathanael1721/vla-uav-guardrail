{% extends "sentence/_base.j2" %}
{#- Keep-IN tube that replaces another corridor while it is in force (grant:
    "Replaces an active corridor with another at runtime"). Worded as the
    corridor sentence plus the corridor it replaces, so the model is not left
    holding two tubes it must be inside at once. -#}
{% block core %}Stay inside corridor '{{ r.id }}', which replaces '{{ r.target_id }}', within {{ r.half_width_m|g }} m of its centerline and between {{ r.altitude_floor_m|g }} m and {{ r.altitude_ceiling_m|g }} m{% endblock %}
