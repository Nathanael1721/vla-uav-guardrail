// The CityLife follow quad, flown by ArduPilot SITL instead of simple_flight.
//
// TEMPLATE. The two IP addresses below are placeholders. rail.py renders the
// real ones into the run's own copy (demo/out/<tag>/pas_config/) before the
// client loads the scene, because under WSL2 NAT they change on every WSL
// restart. Loading this file as it stands is correct only for WSL2 mirrored
// networking, where 127.0.0.1 reaches across in both directions.
//
// WHAT CHANGED FROM demo/pas_config/robot_semantic_quad.jsonc, AND WHY
//
//   controller   "ardupilot-api" (Project AirSim's ArduCopterApi) replaces
//                "simple-flight-api". Each physics step the simulator sends one
//                JSON sensor frame over UDP to ArduPilot's AirSim backend
//                (timestamp, imu, pose, gps, velocity) and applies the 11 PWM
//                values ArduPilot sends back. ArduPilot, not the simulator,
//                closes the inner loop.
//   GPS, baro,   enabled. ArduCopterApi refuses to start without an IMU, and
//   magnetometer ArduPilot's EKF has no position without GPS. The JSON frame
//                carries IMU, attitude, GPS and velocity; ArduPilot's SITL
//                synthesises its barometer and compass from that state.
//   DownCamera   removed. The ArduPilot rail's node never reads it, and every
//                capture costs GPU time on the card the detector shares.
//
// UNCHANGED, ON PURPOSE: the frame, mass, links and the four rotors are
// identical to IAMAI's own ArduPilot example (client/python/example_user_scripts/
// ardupilot/sim_config/robot_ardu_quadrotor.jsonc), so its ArduPilot rate-loop
// tuning (project-airsim-quad.param) is the tuning this airframe was flown with.
// tests/test_pas_ardupilot.py checks that identity when the example is on disk.
//
// ACTUATOR ORDER is ArduCopter's quad-X motor numbering, and it is load-bearing:
// output 1 = front-right (CCW), 2 = rear-left (CCW), 3 = front-left (CW),
// 4 = rear-right (CW). A swapped pair flips the yaw torque and the aircraft
// spins on take-off. rail.check_robot_config() refuses any other order.
//
// "use-sensor-distance" is the key the shipped ArduCopterApi binary reads (found
// in PASBlocks' multirotor_api.lib). IAMAI's example and the client schema spell
// it "use-distance-sensor", which the binary never reads. This airframe has no
// distance sensor, so the key is omitted and the binary's default (false) holds.
{
  "physics-type": "fast-physics",
  "links": [
    {
      "name": "Frame",
      "inertial": {
        "mass": 1.0,
        "inertia": {
          "type": "geometry",
          "geometry": {
            "box": {
              "size": "0.180 0.110 0.040"
            }
          }
        },
        "aerodynamics": {
          "drag-coefficient": 0.325,
          "type": "geometry",
          "geometry": {
            "box": {
              "size": "0.180 0.110 0.040"
            }
          }
        }
      },
      "collision": {
        "restitution": 0.1,
        "friction": 0.5
      },
      "visual": {
        "geometry": {
          "type": "unreal_mesh",
          "name": "/Drone/Quadrotor1"
        }
      }
    },
    {
      "name": "Prop_FL",
      "inertial": {
        "origin": {
          "xyz": "0.253 -0.253 -0.01",
          "rpy-deg": "0 0 0"
        },
        "mass": 0.055,
        "inertia": {
          "type": "point-mass"
        },
        "aerodynamics": {
          "drag-coefficient": 0.325,
          "type": "geometry",
          "geometry": {
            "cylinder": {
              "radius": 0.1143,
              "length": 0.01
            }
          }
        }
      },
      "visual": {
        "origin": {
          "xyz": "0.253 -0.253 -0.01",
          "rpy-deg": "0 0 0"
        },
        "geometry": {
          "type": "unreal_mesh",
          "name": "/Drone/PropellerRed"
        }
      }
    },
    {
      "name": "Prop_FR",
      "inertial": {
        "origin": {
          "xyz": "0.253 0.253 -0.01",
          "rpy-deg": "0 0 0"
        },
        "mass": 0.055,
        "inertia": {
          "type": "point-mass"
        },
        "aerodynamics": {
          "drag-coefficient": 0.325,
          "type": "geometry",
          "geometry": {
            "cylinder": {
              "radius": 0.1143,
              "length": 0.01
            }
          }
        }
      },
      "visual": {
        "origin": {
          "xyz": "0.253 0.253 -0.01",
          "rpy-deg": "0 0 0"
        },
        "geometry": {
          "type": "unreal_mesh",
          "name": "/Drone/PropellerRed"
        }
      }
    },
    {
      "name": "Prop_RL",
      "inertial": {
        "origin": {
          "xyz": "-0.253 -0.253 -0.01",
          "rpy-deg": "0 0 0"
        },
        "mass": 0.055,
        "inertia": {
          "type": "point-mass"
        },
        "aerodynamics": {
          "drag-coefficient": 0.325,
          "type": "geometry",
          "geometry": {
            "cylinder": {
              "radius": 0.1143,
              "length": 0.01
            }
          }
        }
      },
      "visual": {
        "origin": {
          "xyz": "-0.253 -0.253 -0.01",
          "rpy-deg": "0 0 0"
        },
        "geometry": {
          "type": "unreal_mesh",
          "name": "/Drone/PropellerWhite"
        }
      }
    },
    {
      "name": "Prop_RR",
      "inertial": {
        "origin": {
          "xyz": "-0.253 0.253 -0.01",
          "rpy-deg": "0 0 0"
        },
        "mass": 0.055,
        "inertia": {
          "type": "point-mass"
        },
        "aerodynamics": {
          "drag-coefficient": 0.325,
          "type": "geometry",
          "geometry": {
            "cylinder": {
              "radius": 0.1143,
              "length": 0.01
            }
          }
        }
      },
      "visual": {
        "origin": {
          "xyz": "-0.253 0.253 -0.01",
          "rpy-deg": "0 0 0"
        },
        "geometry": {
          "type": "unreal_mesh",
          "name": "/Drone/PropellerWhite"
        }
      }
    }
  ],
  "joints": [
    {
      "id": "Frame_Prop_FL",
      "type": "fixed",
      "parent-link": "Frame",
      "child-link": "Prop_FL",
      "axis": "0 0 1"
    },
    {
      "id": "Frame_Prop_FR",
      "type": "fixed",
      "parent-link": "Frame",
      "child-link": "Prop_FR",
      "axis": "0 0 1"
    },
    {
      "id": "Frame_Prop_RL",
      "type": "fixed",
      "parent-link": "Frame",
      "child-link": "Prop_RL",
      "axis": "0 0 1"
    },
    {
      "id": "Frame_Prop_RR",
      "type": "fixed",
      "parent-link": "Frame",
      "child-link": "Prop_RR",
      "axis": "0 0 1"
    }
  ],
  "controller": {
    "id": "ArduPilot_Controller",
    "type": "ardupilot-api",
    "ardupilot-settings": {
      // Where ArduPilot SITL listens for sensor frames (its --sim-port-in,
      // default 9003). Under WSL2 NAT this is the WSL eth0 address.
      "ardupilot-ip": "127.0.0.1",
      "ardupilot-udp-port": 9003,
      // Where THIS simulator binds to receive the PWM ArduPilot sends to its
      // --sim-address:--sim-port-out (default 9002). Under WSL2 NAT this is the
      // Windows end of the WSL virtual switch, the address WSL sees as its
      // default gateway; 127.0.0.1 there would bind to loopback and never see
      // a datagram from WSL.
      "local-host-ip": "127.0.0.1",
      "local-host-udp-port": 9002,
      "actuator-order": [
        {
          "id": "Prop_FR_actuator"
        },
        {
          "id": "Prop_RL_actuator"
        },
        {
          "id": "Prop_FL_actuator"
        },
        {
          "id": "Prop_RR_actuator"
        }
      ]
    }
  },
  "actuators": [
    {
      "name": "Prop_FL_actuator",
      "type": "rotor",
      "enabled": true,
      "parent-link": "Frame",
      "child-link": "Prop_FL",
      "origin": {
        "xyz": "0.253 -0.253 -0.01",
        "rpy-deg": "0 0 0"
      },
      "rotor-settings": {
        "turning-direction": "clock-wise",
        "normal-vector": "0.0 0.0 -1.0",
        "coeff-of-thrust": 0.109919,
        "coeff-of-torque": 0.040164,
        "max-rpm": 6396.667,
        "propeller-diameter": 0.2286,
        "smoothing-tc": 0.005
      }
    },
    {
      "name": "Prop_FR_actuator",
      "type": "rotor",
      "enabled": true,
      "parent-link": "Frame",
      "child-link": "Prop_FR",
      "origin": {
        "xyz": "0.253 0.253 -0.01",
        "rpy-deg": "0 0 0"
      },
      "rotor-settings": {
        "turning-direction": "counter-clock-wise",
        "normal-vector": "0.0 0.0 -1.0",
        "coeff-of-thrust": 0.109919,
        "coeff-of-torque": 0.040164,
        "max-rpm": 6396.667,
        "propeller-diameter": 0.2286,
        "smoothing-tc": 0.005
      }
    },
    {
      "name": "Prop_RL_actuator",
      "type": "rotor",
      "enabled": true,
      "parent-link": "Frame",
      "child-link": "Prop_RL",
      "origin": {
        "xyz": "-0.253 -0.253 -0.01",
        "rpy-deg": "0 0 0"
      },
      "rotor-settings": {
        "turning-direction": "counter-clock-wise",
        "normal-vector": "0.0 0.0 -1.0",
        "coeff-of-thrust": 0.109919,
        "coeff-of-torque": 0.040164,
        "max-rpm": 6396.667,
        "propeller-diameter": 0.2286,
        "smoothing-tc": 0.005
      }
    },
    {
      "name": "Prop_RR_actuator",
      "type": "rotor",
      "enabled": true,
      "parent-link": "Frame",
      "child-link": "Prop_RR",
      "origin": {
        "xyz": "-0.253 0.253 -0.01",
        "rpy-deg": "0 0 0"
      },
      "rotor-settings": {
        "turning-direction": "clock-wise",
        "normal-vector": "0.0 0.0 -1.0",
        "coeff-of-thrust": 0.109919,
        "coeff-of-torque": 0.040164,
        "max-rpm": 6396.667,
        "propeller-diameter": 0.2286,
        "smoothing-tc": 0.005
      }
    }
  ],
  "sensors": [
    {
      // The detector's camera, as on the simple_flight rail: 768x432 scene
      // capture pitched 20 deg down, and a depth capture at the SAME size and
      // field of view (the box indexes straight into it). See
      // robot_semantic_quad.jsonc for the measurements behind each value.
      "id": "FrontCamera",
      "type": "camera",
      "enabled": true,
      "parent-link": "Frame",
      "capture-interval": 0.1,
      "capture-settings": [
        {
          "image-type": 0,
          "width": 768,
          "height": 432,
          "fov-degrees": 90,
          "capture-enabled": true,
          "streaming-enabled": false,
          "pixels-as-float": false,
          "compress": false,
          "target-gamma": 2.5
        },
        {
          "image-type": 2,
          "width": 768,
          "height": 432,
          "fov-degrees": 90,
          "capture-enabled": true,
          "streaming-enabled": true,
          "pixels-as-float": true,
          "compress": false
        }
      ],
      "origin": {
        "xyz": "0.3 0.0 0.0",
        "rpy-deg": "0 -20.0 0"
      }
    },
    {
      // Third-person view for the demo video and for G1 condition 2's image
      // evidence (the vehicle moving in the simulator's own view).
      "id": "Chase",
      "type": "camera",
      "enabled": true,
      "parent-link": "Frame",
      "capture-interval": 0.05,
      "capture-settings": [
        {
          "image-type": 0,
          "width": 960,
          "height": 540,
          "fov-degrees": 90,
          "capture-enabled": true,
          "streaming-enabled": true,
          "pixels-as-float": false,
          "compress": false,
          "target-gamma": 2.5
        }
      ],
      "gimbal": {
        "lock-roll": true,
        "lock-pitch": true,
        "lock-yaw": false
      },
      "origin": {
        "xyz": "-16.0 0.0 -7.0",
        "rpy-deg": "0 -22 0"
      }
    },
    {
      "id": "IMU1",
      "type": "imu",
      "enabled": true,
      "parent-link": "Frame",
      "accelerometer": {
        "velocity-random-walk": 0.002353,
        "tau": 800,
        "bias-stability": 0.000353,
        "turn-on-bias": "0 0 0"
      },
      "gyroscope": {
        "angle-random-walk": 8.72644e-05,
        "tau": 500,
        "bias-stability": 2.23014e-05,
        "turn-on-bias": "0 0 0"
      }
    },
    {
      "id": "GPS",
      "type": "gps",
      "enabled": true,
      "parent-link": "Frame"
    },
    {
      "id": "Barometer",
      "type": "barometer",
      "enabled": true,
      "parent-link": "Frame"
    },
    {
      "id": "Magnetometer",
      "type": "magnetometer",
      "enabled": true,
      "parent-link": "Frame"
    }
  ]
}
