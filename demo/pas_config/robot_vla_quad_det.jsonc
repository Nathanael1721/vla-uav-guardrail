// The AerialVLA pilot's airframe and cameras for mission M2 APPROACH
// (demo/vla_fly.py --mission approach).
//
// GENERATED like robot_vla_quad.jsonc (see its header: the same airframe, the
// same VLAFront/VLADown pair matching AerialVLA's training cameras, the same
// Chase), plus the DETECTOR'S OWN CAMERA: FrontCamera, 768x432 Scene, 90 deg,
// pitched -20 deg, exactly the follow rail's (robot_semantic_quad.jsonc, whose
// header says why 768 wide: OwlViTProcessor resizes every input to 768x768,
// so 768 is the widest capture it uses, and every measured OWL-ViT number in
// this repository is on this camera). No depth stream: the VLA rail estimates
// no range.
//
// Why OWL-ViT does not reuse VLAFront: a 256x256 frame would be upscaled 3x
// into OWL-ViT's 768x768 input, and a 3.7 m car at 30 m spans about 24 px of
// it against 73 px on this camera; and a level camera at 10 m sees the road
// only from 10 m out, where the -20 deg mount sees it from 8.6 m. Both
// cameras face forward from the nose, so the box bearing the bridge turns
// into a phrase (demo/vla_bridge.py, pinhole at hfov 90) is the bearing from
// the same heading the VLA's front tile looks along.
{
  "physics-type": "fast-physics",
  "links": [
    {
      "name": "Frame",
      "inertial": {
        "mass": 1.0,
        "inertia": {
          "type": "geometry",
          "geometry": {
            "box": {
              "size": "0.180 0.110 0.040"
            }
          }
        },
        "aerodynamics": {
          "drag-coefficient": 0.325,
          "type": "geometry",
          "geometry": {
            "box": {
              "size": "0.180 0.110 0.040"
            }
          }
        }
      },
      "collision": {
        "restitution": 0.1,
        "friction": 0.5
      },
      "visual": {
