# Topology: hil - desktop + Jetson Orin, the grant's canonical KPI configuration.
# Desktop: docker compose --env-file deploy/topologies/hil.env -f deploy/compose/docker-compose.hil-desktop.yml up
# Orin:    docker compose --env-file deploy/topologies/hil.env -f deploy/compose/docker-compose.orin.yml up -d mavros
#
# The Orin runs MAVROS 2, the Shield and the VLA (reference
# docs/03-simulation/topologies.md, hil). The desktop runs ArduPilot SITL,
# mavlink-router, Project AirSim and Mission Planner. The only traffic that
# crosses the cable is MAVLink over UDP (router -> Orin:14555 and back), plus
# Project AirSim's client API (TCP 8989/8990) when a camera VLA runs on the
# Orin. docs/RUNBOOK-orin-hil.md sets these addresses up.
VLAGUARD_TOPOLOGY=hil

# The hil machine is the AGX Orin 64 GB on JetPack 7.2.1 (L4T r39.2.1, Ubuntu
# 24.04) since 2026-11-03. The companion image is ROS 2 Jazzy on an Ubuntu
# 24.04 user space, runs with runc and uses no GPU, so it is the same on any
# JetPack. The VLA image below was written for JetPack 6.2 (r36.4 bases) and is
# not used on r39: the VLA runs natively in the environment
# deploy/orin/agx_vla_env.sh builds (docs/DESIGN-topologies.md, decision 11).
# On a JetPack 6.2 Orin the VLA image keeps the r36.4 PyTorch base below
# (torch 2.6 + torchvision 0.21.0, Python 3.12, CUDA 12.8 with forward
# compatibility); fallback base if deploy/orin/gpu_check.py fails on it:
# dustynv/l4t-pytorch:r36.4.0 (docs/DESIGN-topologies.md, "JetPack 6.2").
VLAGUARD_IMAGE=vlaguard/companion:jazzy
VLAGUARD_SITL_IMAGE=vlaguard/sitl:copter-4.5.7
VLAGUARD_VLA_IMAGE=vlaguard/vla:l4t-r36.4-cu128
VLA_BASE_IMAGE=dustynv/torchvision:0.21.0-r36.4.0-cu128-24.04
VLA_BACKEND=aerialvla_ft_run2
VLAGUARD_MODEL_ROOT=/opt/models

ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
VLAGUARD_DDS_PEER_A=10.42.0.1
VLAGUARD_DDS_PEER_B=10.42.0.3

SITL_MAVLINK_PORT=14550
MAVROS_HOST=10.42.0.3
MAVROS_UDP_PORT=14555
# MAVROS on the Orin binds UDP 14555 and names the desktop as its remote.
# guardrail.manifest reads hil when the SITL autopilot is shown to run off the
# Orin: by this remote, or by the mission's /proc scan finding no SITL on the
# Orin (pid: host). The remote holds even where no scan could be made, and it
# gives the link record its route and interface (Ethernet); an empty remote
# (udp://:14555@) gives neither. MAVROS then answers whichever address the
# router's MAVLink actually arrives from.
FCU_URL=udp://:14555@10.42.0.1:14555
FCU_DEVICE=
GCS_HOST=host.docker.internal
GCS_UDP_PORT=14550

SITL_MODEL=quad
SITL_HOME=-35.363261,149.165230,584,0
SITL_AIRFRAME_PARM=
GUARDRAIL_FENCE=1
SITL_WIPE=1
AIRSIM_HOST=host.docker.internal

# Direct Ethernet cable, static addresses (docs/RUNBOOK-orin-hil.md, step 5):
# the desktop's 2.5 Gbps port and the AGX Orin's end0 since 2026-11-03 (the
# runbook's pictures still show the 192.168.50.x plan of October).
DESKTOP_IP=10.42.0.1
ORIN_IP=10.42.0.3

VLAGUARD_BAG=1
# 1 = the mission's bag also carries the manifest fields known at launch in
# its metadata.yaml custom_data (sitl/bag_custom_data.py). Off: the record
# command is the one every campaign up to ntFIN2 ran. To turn it on for one
# campaign without editing this file, export it in the shell that runs
# docker compose: the shell's value wins over an --env-file.
VLAGUARD_BAG_MANIFEST=0

VLAGUARD_ALLOW_FLIGHT_MISSION=no

# 1 = the companion flies only a policy bundle whose signer's certificate
# chained to a listed certificate authority there (guardrail.bundle
# load_for_flight, require_chain; WP1-04). 1 since 27 Nov 2026: both bundle
# keys are certified by the lab root CA (authority `lab-ca` in
# policies/keys/trusted_signers.json) and the flight bundles re-signed on
# both machines (docs/RUNBOOK-bundle-ca.md). A bundle still signed by a bare
# key is refused before take-off. The runs flown before that date flew with 0.
VLAGUARD_REQUIRE_CHAIN=1
