# Topology: hil - desktop + Jetson Orin, the grant's canonical KPI configuration.
# Desktop: docker compose --env-file deploy/topologies/hil.env -f deploy/compose/docker-compose.hil-desktop.yml up
# Orin:    docker compose --env-file deploy/topologies/hil.env -f deploy/compose/docker-compose.orin.yml up -d mavros
#
# The Orin runs MAVROS 2, the Shield and the VLA (reference
# docs/03-simulation/topologies.md, hil). The desktop runs ArduPilot SITL,
# mavlink-router, Project AirSim and Mission Planner. The only traffic that
# crosses the cable is MAVLink over UDP (router -> Orin:14555 and back), plus
# Project AirSim's client API (TCP 8989/8990) when a camera VLA runs on the
# Orin. docs/RUNBOOK-orin-hil.md sets these addresses up.
VLAGUARD_TOPOLOGY=hil

VLAGUARD_IMAGE=vlaguard/companion:jazzy
VLAGUARD_SITL_IMAGE=vlaguard/sitl:copter-4.5.7
VLAGUARD_VLA_IMAGE=vlaguard/vla:l4t-r36
VLA_BASE_IMAGE=dustynv/l4t-pytorch:r36.4.0
VLA_BACKEND=aerialvla_ft_run2
VLAGUARD_MODEL_ROOT=/opt/models

ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
VLAGUARD_DDS_PEER_A=192.168.50.1
VLAGUARD_DDS_PEER_B=192.168.50.2

SITL_MAVLINK_PORT=14550
MAVROS_HOST=192.168.50.2
MAVROS_UDP_PORT=14555
# MAVROS on the Orin binds UDP 14555 and names the desktop as its remote.
# guardrail.manifest reads hil when the SITL autopilot is shown to run off the
# Orin: by this remote, or by the mission's /proc scan finding no SITL on the
# Orin (pid: host). The remote holds even where no scan could be made, and it
# gives the link record its route and interface (Ethernet); an empty remote
# (udp://:14555@) gives neither. MAVROS then answers whichever address the
# router's MAVLink actually arrives from.
FCU_URL=udp://:14555@192.168.50.1:14555
FCU_DEVICE=
GCS_HOST=host.docker.internal
GCS_UDP_PORT=14550

SITL_MODEL=quad
SITL_HOME=-35.363261,149.165230,584,0
SITL_AIRFRAME_PARM=
GUARDRAIL_FENCE=1
SITL_WIPE=1
AIRSIM_HOST=host.docker.internal

# Direct Ethernet cable, static addresses (docs/RUNBOOK-orin-hil.md, step 3).
DESKTOP_IP=192.168.50.1
ORIN_IP=192.168.50.2

VLAGUARD_BAG=1

VLAGUARD_ALLOW_FLIGHT_MISSION=no
