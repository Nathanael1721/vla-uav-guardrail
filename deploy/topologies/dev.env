# Topology: dev - everything on one desktop (grant, Architecture constraints p.3).
# Use with: docker compose --env-file deploy/topologies/dev.env -f deploy/compose/docker-compose.dev.yml ...
# Not used for reported KPI numbers (reference docs/03-simulation/topologies.md).
#
# The three files dev.env, hil.env and flight.env define the SAME keys; only the
# values differ. tests/test_deploy_configs.py checks that, and that every value
# a compose file reads is defined here. VLAGUARD_TOPOLOGY selects configuration;
# the label a run's manifest carries comes from evidence
# (guardrail.manifest.detect_topology), never from this file.
VLAGUARD_TOPOLOGY=dev

# Images. The companion image is one multi-arch definition (amd64 here, arm64 on
# the Orin), so dev, hil and flight name the same tag.
VLAGUARD_IMAGE=vlaguard/companion:jazzy
VLAGUARD_SITL_IMAGE=vlaguard/sitl:copter-4.5.7
VLAGUARD_VLA_IMAGE=vlaguard/vla:desktop-cu124
VLA_BASE_IMAGE=pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime
VLA_BACKEND=aerialvla_ft_run2
VLAGUARD_MODEL_ROOT=D:/models

# ROS 2 graph. Every ROS node shares one network namespace in dev (the router's).
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
VLAGUARD_DDS_PEER_A=127.0.0.1
VLAGUARD_DDS_PEER_B=127.0.0.1

# MAVLink. ArduPilot SITL -> mavlink-router on UDP 14550 (the grant's MAVLink
# port), router -> MAVROS 2 on 14555 and -> Mission Planner on 14550 in parallel
# (sitl/mavlink-router/main.conf, rendered by sitl/start_router.sh). MAVROS
# shares the router's namespace, so its link is local: the same fcu_url as the
# native WSL rail (sitl/run_ros2_demo.sh).
SITL_MAVLINK_PORT=14550
MAVROS_HOST=127.0.0.1
MAVROS_UDP_PORT=14555
FCU_URL=udp://:14555@
FCU_DEVICE=
GCS_HOST=host.docker.internal
GCS_UDP_PORT=14550

# Simulator. quad = ArduPilot's built-in physics (the rail of the stored ros2_*
# runs), with the GeoFence backstop and the EEPROM wiped at every start, as
# sitl/start_sitl.sh. airsim-copter = Project AirSim computes the physics and
# sensors through its native ardupilot-api controller (UDP 9002/9003); it also
# needs SITL_HOME = the scene's home-geo-point and SITL_AIRFRAME_PARM
# (deploy/docker/sitl-entrypoint.sh refuses it otherwise).
SITL_MODEL=quad
SITL_HOME=-35.363261,149.165230,584,0
SITL_AIRFRAME_PARM=
GUARDRAIL_FENCE=1
SITL_WIPE=1
AIRSIM_HOST=host.docker.internal

# Network addresses of the two hosts (hil only; loopback here).
DESKTOP_IP=127.0.0.1
ORIN_IP=127.0.0.1

# The mission role records the grant's topics with rosbag2, as the native rail.
VLAGUARD_BAG=1

# The Shield node arms and takes off. Only the flight topology refuses that
# without an explicit yes.
VLAGUARD_ALLOW_FLIGHT_MISSION=no
