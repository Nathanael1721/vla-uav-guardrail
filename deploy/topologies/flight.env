# Topology: flight - the Orin as a companion computer on a real ArduPilot autopilot.
# Orin: docker compose --env-file <your copy of flight.env> -f deploy/compose/docker-compose.orin.yml \
#                      -f deploy/compose/docker-compose.orin.flight.yml up -d mavros
#
# Same images and the same compose file as hil on the Orin, plus a flight-only
# override that maps the autopilot's serial device; only this file differs.
# There is no simulator and no desktop: MAVROS talks to the autopilot over a
# serial link, and Mission Planner reaches the autopilot through its own
# telemetry radio (reference docs/03-simulation/topologies.md, flight).
VLAGUARD_TOPOLOGY=flight

VLAGUARD_IMAGE=vlaguard/companion:jazzy
VLAGUARD_SITL_IMAGE=vlaguard/sitl:copter-4.5.7
VLAGUARD_VLA_IMAGE=vlaguard/vla:l4t-r36
VLA_BASE_IMAGE=dustynv/l4t-pytorch:r36.4.0
VLA_BACKEND=aerialvla_ft_run2
VLAGUARD_MODEL_ROOT=/opt/models

ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
VLAGUARD_DDS_PEER_A=127.0.0.1
VLAGUARD_DDS_PEER_B=127.0.0.1

SITL_MAVLINK_PORT=14550
MAVROS_HOST=127.0.0.1
MAVROS_UDP_PORT=14555
# Left empty on purpose: the airframe does not exist yet, and the link depends
# on how the autopilot is wired. The entrypoint refuses to start MAVROS until
# FCU_URL is set, e.g. serial:///dev/ttyACM0:115200 (USB) or
# serial:///dev/ttyTHS1:921600 (a TELEM port on the carrier board's UART), and
# the flight override refuses to start until FCU_DEVICE names the same device.
# docs/RUNBOOK-orin-hil.md, "Moving to the drone".
FCU_URL=
FCU_DEVICE=
GCS_HOST=127.0.0.1
GCS_UDP_PORT=14550

SITL_MODEL=quad
SITL_HOME=-35.363261,149.165230,584,0
SITL_AIRFRAME_PARM=
GUARDRAIL_FENCE=1
SITL_WIPE=1
AIRSIM_HOST=127.0.0.1

DESKTOP_IP=127.0.0.1
ORIN_IP=127.0.0.1

VLAGUARD_BAG=1

# The Shield node arms the vehicle and takes off. On a real airframe that is
# refused until this says yes, after the bench checks in the runbook.
VLAGUARD_ALLOW_FLIGHT_MISSION=no
